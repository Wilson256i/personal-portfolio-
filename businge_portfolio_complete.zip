<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Akiiki — Busingye Wilson</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet">
<noscript><style>#preloader{display:none !important;}</style></noscript>
<style>
  :root{
    --ink:#0a0d0c;
    --surface:#121815;
    --surface-2:#1a221d;
    --gold:#c9a24b;
    --green:#5c8a68;
    --cream:#f1ecdd;
    --muted:#8c9089;
    --line: rgba(241,236,221,0.08);
    --ease: cubic-bezier(.16,1,.3,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background:var(--ink);
    color:var(--cream);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    cursor:default;
    position:relative;
  }
  body.locked{ overflow:hidden; height:100vh; }

  ::selection{ background:var(--gold); color:var(--ink); }

  /* ambient cursor glow */
  .glow{
    position:fixed;
    width:420px; height:420px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(201,162,75,0.10), transparent 70%);
    pointer-events:none;
    transform:translate(-50%,-50%);
    z-index:1;
    transition:opacity .3s ease, width .4s ease, height .4s ease;
  }
  .glow.big{ width:620px; height:620px; }

  /* ambient background blobs */
  .blob{ position:fixed; border-radius:50%; filter:blur(70px); pointer-events:none; z-index:0; opacity:.55; will-change:transform; }
  .blob-1{ width:420px;height:420px; background:radial-gradient(circle, rgba(92,138,104,.35), transparent 70%); top:-8%; left:-8%; animation:driftA 17s ease-in-out infinite alternate; }
  .blob-2{ width:360px;height:360px; background:radial-gradient(circle, rgba(201,162,75,.20), transparent 70%); bottom:-12%; right:-8%; animation:driftB 21s ease-in-out infinite alternate; }
  @keyframes driftA{ from{ transform:translate(0,0); } to{ transform:translate(50px,70px); } }
  @keyframes driftB{ from{ transform:translate(0,0); } to{ transform:translate(-60px,-45px); } }

  /* ===== PRELOADER ===== */
  #preloader{
    position:fixed; inset:0; z-index:9999;
    background:var(--ink);
    display:flex; align-items:center; justify-content:center; flex-direction:column; gap:16px;
    transition:opacity .9s ease, transform .9s var(--ease);
  }
  #preloader.hide{ opacity:0; transform:translateY(-6%); pointer-events:none; }
  .pre-word{ display:flex; font-family:'Fraunces',serif; font-weight:300; font-size:clamp(2.2rem, 8vw, 4.2rem); letter-spacing:0.06em; color:var(--cream); }
  .pre-letter{ opacity:0; transform:translateY(36px); display:inline-block; transition:opacity .6s var(--ease), transform .6s var(--ease); }
  .pre-letter.show{ opacity:1; transform:translateY(0); }
  .pre-line{ width:0; height:1px; background:var(--gold); transition:width 1s var(--ease); }
  .pre-line.grow{ width:120px; }
  .pre-tag{ font-family:'JetBrains Mono',monospace; font-size:0.65rem; letter-spacing:0.3em; color:var(--muted); opacity:0; transition:opacity .8s ease; }
  .pre-tag.show{ opacity:1; }

  nav{
    position:fixed; top:0; left:0; right:0;
    display:flex; justify-content:space-between; align-items:center;
    gap:16px;
    padding:clamp(16px, 3vh, 26px) clamp(20px, 6vw, 100px);
    max-width:1560px;
    margin:0 auto;
    z-index:50;
    mix-blend-mode:difference;
  }
  .brandmark{
    font-family:'Fraunces',serif;
    font-weight:500;
    letter-spacing:0.04em;
    font-size:clamp(0.95rem, 2.5vw, 1.05rem);
    white-space:nowrap;
  }
  .navtag{
    font-family:'JetBrains Mono',monospace;
    font-size:clamp(0.58rem, 1.8vw, 0.68rem);
    letter-spacing:0.14em;
    color:var(--muted);
    text-align:right;
    white-space:nowrap;
  }
  .progress{
    position:fixed; top:0; left:0; height:2px; background:var(--gold);
    z-index:60; width:0%;
    transition:width .1s linear;
  }

  /* ===== CHAPTER NAV ===== */
  .chapter-nav{
    position:fixed; right:26px; top:50%; transform:translateY(-50%);
    z-index:40; display:flex; flex-direction:column; gap:18px;
  }
  .chapter-dot{
    width:8px; height:8px; border-radius:50%;
    background:var(--muted); opacity:.45;
    cursor:pointer; position:relative; border:none; padding:0;
    transition:background .3s ease, opacity .3s ease, transform .3s ease;
  }
  .chapter-dot.active{ background:var(--gold); opacity:1; transform:scale(1.4); }
  .chapter-dot .chapter-label{
    position:absolute; right:20px; top:50%; transform:translateY(-50%);
    font-family:'JetBrains Mono',monospace; font-size:0.64rem; letter-spacing:0.12em;
    color:var(--muted); white-space:nowrap; opacity:0; transition:opacity .25s ease;
    pointer-events:none;
  }
  .chapter-dot:hover .chapter-label{ opacity:1; }
  @media (max-width:900px){ .chapter-nav{ display:none; } }

  section, header.hero{
    position:relative;
    z-index:2;
    padding:clamp(64px, 14vh, 140px) clamp(20px, 8vw, 100px);
    max-width:1440px;
    margin:0 auto;
  }

  /* HERO */
  .hero{
    min-height:100vh;
    min-height:100svh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding-top:clamp(90px, 12vh, 140px);
    padding-bottom:clamp(70px, 10vh, 120px);
  }
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:0.7rem;
    letter-spacing:0.28em;
    color:var(--green);
    margin-bottom:26px;
    opacity:0;
    animation:fadeUp .9s ease forwards .2s;
  }
  .display-name{
    font-family:'Fraunces',serif;
    font-weight:300;
    font-size:clamp(3.2rem, 11vw, 8.5rem);
    line-height:0.94;
    letter-spacing:-0.01em;
    opacity:0;
    animation:fadeUp 1s ease forwards .4s;
  }
  .display-name em{
    font-style:italic;
    font-weight:400;
    color:var(--gold);
  }
  .akiiki-tag{
    margin-top:22px;
    font-size:1rem;
    color:var(--muted);
    opacity:0;
    animation:fadeUp .9s ease forwards .7s;
  }
  .akiiki-tag span{
    font-family:'Fraunces',serif;
    font-style:italic;
    color:var(--cream);
    font-size:1.15rem;
  }
  .typed-wrap{
    margin-top:60px;
    font-family:'JetBrains Mono',monospace;
    font-size:clamp(0.85rem, 1.6vw, 1.05rem);
    color:var(--green);
    min-height:1.6em;
    opacity:0;
    animation:fadeUp .9s ease forwards 1s;
  }
  .cursor-blink{
    display:inline-block;
    width:8px; height:1.1em;
    background:var(--gold);
    margin-left:4px;
    vertical-align:text-bottom;
    animation:blink 1s step-start infinite;
  }
  @keyframes blink{ 50%{opacity:0;} }
  @keyframes fadeUp{
    from{opacity:0; transform:translateY(18px);}
    to{opacity:1; transform:translateY(0);}
  }

  .waveline{
    margin-top:70px;
    width:min(560px, 80vw);
    opacity:0;
    animation:fadeUp 1s ease forwards 1.3s;
  }
  .waveline svg{ width:100%; height:auto; display:block; }
  .waveline path{
    fill:none; stroke:var(--line); stroke-width:1.4;
  }
  .waveline path.pulse{
    stroke:var(--gold);
    stroke-dasharray:900;
    stroke-dashoffset:900;
    animation:drawline 3.2s ease-in-out .5s infinite;
  }
  @keyframes drawline{
    0%{stroke-dashoffset:900;}
    45%{stroke-dashoffset:0;}
    100%{stroke-dashoffset:-900;}
  }

  .scroll-cue{
    position:absolute; bottom:6vh; left:8vw;
    font-family:'JetBrains Mono',monospace;
    font-size:0.68rem; letter-spacing:0.2em; color:var(--muted);
    display:flex; align-items:center; gap:10px;
  }
  .scroll-cue .bar{
    width:1px; height:30px; background:var(--muted);
    position:relative; overflow:hidden;
  }
  .scroll-cue .bar::after{
    content:''; position:absolute; top:-100%; left:0; width:100%; height:100%;
    background:var(--gold);
    animation:dropline 1.8s ease-in-out infinite;
  }
  @keyframes dropline{ 0%{top:-100%;} 60%{top:100%;} 100%{top:100%;} }

  /* reveal utility (fallback + paragraphs) */
  .reveal{ opacity:0; transform:translateY(28px); transition:opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.in-view{ opacity:1; transform:translateY(0); }

  #mainNav.reveal{ transform:translateY(-16px); }
  #mainNav.reveal.in-view{ transform:translateY(0); }

  /* generic per-child stagger group: apply data-stagger to a wrapper,
     JS assigns transition-delay to each direct child, CSS handles the motion */
  .stagger-child{
    opacity:0; transform:translateY(24px);
    transition:opacity .7s var(--ease), transform .7s var(--ease);
  }
  [data-stagger].in-view > .stagger-child{ opacity:1; transform:translateY(0); }

  .card-pop{
    opacity:0; transform:translateY(30px) scale(.95) rotate(-1deg);
    transition:opacity .7s var(--ease), transform .7s var(--ease), background .4s ease;
  }
  [data-stagger].in-view .card-pop{ opacity:1; transform:translateY(0) scale(1) rotate(0deg); }

  .pin-reveal{
    opacity:0; transform:scale(.7) rotate(-6deg);
    transition:opacity .9s var(--ease) .15s, transform .9s var(--ease) .15s;
  }
  .roots.in-view .pin-reveal{ opacity:1; transform:scale(1) rotate(0deg); }

  @keyframes dotPulse{ 0%,100%{ opacity:.35; } 50%{ opacity:.65; } }
  .chapter-dot:not(.active){ animation:dotPulse 2.6s ease-in-out infinite; }

  /* split word reveal */
  .word{ display:inline-block; overflow:hidden; vertical-align:top; }
  .word-inner{ display:inline-block; transform:translateY(112%); opacity:0; transition:transform .7s var(--ease), opacity .5s ease; }
  .split.in-view .word-inner{ transform:translateY(0); opacity:1; }

  h2.section-title{
    font-family:'Fraunces',serif;
    font-weight:400;
    font-size:clamp(2rem, 4.4vw, 3.3rem);
    line-height:1.1;
    max-width:14ch;
    margin-bottom:36px;
  }
  h2.section-title em{ font-style:italic; color:var(--gold); }

  .mono-mark{
    font-family:'JetBrains Mono',monospace;
    font-size:0.75rem;
    letter-spacing:0.22em;
    color:var(--green);
    margin-bottom:18px;
    display:block;
  }

  /* QUIET SECTION */
  .quiet{
    background:var(--surface);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .quiet-grid{
    display:grid; grid-template-columns: 1.1fr 1fr; gap:60px; align-items:start;
  }
  .quiet p{
    font-size:1.08rem; line-height:1.85; color:var(--cream); max-width:52ch; margin-bottom:22px;
  }
  .quiet p.muted{ color:var(--muted); font-size:1rem; }
  .boast-line{
    font-family:'Fraunces',serif;
    font-style:italic;
    font-size:1.4rem;
    color:var(--gold);
    line-height:1.5;
    border-left:2px solid var(--gold);
    padding-left:24px;
    margin-top:30px;
    max-width:44ch;
  }
  .mini-wave{ margin-top:38px; width:min(320px,70vw); }
  .mini-wave svg{ width:100%; height:auto; display:block; }
  .mini-wave-path{
    fill:none; stroke:var(--gold); stroke-width:1.6;
    stroke-dasharray:500; stroke-dashoffset:500;
    transition:stroke-dashoffset 2s var(--ease) .3s;
  }
  .quiet.in-view .mini-wave-path{ stroke-dashoffset:0; }

  /* ORIGIN 2016 */
  .origin{ text-align:center; overflow:hidden; }
  .origin-content{ display:flex; flex-direction:column; align-items:center; position:relative; z-index:2; }
  #embers-canvas{ position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; }
  .origin-title{ max-width:20ch; margin-left:auto; margin-right:auto; }
  .year-mark{
    font-family:'Fraunces',serif;
    font-weight:300;
    font-size:clamp(5rem, 16vw, 11rem);
    color:transparent;
    -webkit-text-stroke:1.4px var(--gold);
    line-height:1;
    margin-bottom:10px;
    letter-spacing:0.02em;
    opacity:0; transform:scale(.85); filter:blur(6px);
    transition:opacity .9s ease, transform .9s var(--ease), filter .9s ease;
  }
  .origin.in-view .year-mark{ opacity:1; transform:scale(1); filter:blur(0); }
  .origin p{
    max-width:56ch; margin:0 auto 20px; font-size:1.08rem; line-height:1.85; color:var(--cream);
  }
  .origin .muted{ color:var(--muted); }

  /* CRAFT */
  .craft{ background:var(--surface); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .cards{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px;
    background:var(--line);
    margin-top:20px;
    border:1px solid var(--line);
  }
  .card{
    background:var(--ink);
    padding:44px 34px;
    transition:background .4s ease, transform .15s ease-out;
    transform-style:preserve-3d;
    will-change:transform;
  }
  .card:hover{ background:var(--surface-2); }
  .card .tag{
    font-family:'JetBrains Mono',monospace;
    font-size:0.68rem; letter-spacing:0.16em; color:var(--green);
    display:block; margin-bottom:18px;
  }
  .card h3{
    font-family:'Fraunces',serif; font-weight:400; font-size:1.5rem; margin-bottom:14px;
  }
  .card p{ color:var(--muted); font-size:0.98rem; line-height:1.7; }
  .craft-boast{
    margin-top:50px;
    font-family:'Fraunces',serif; font-style:italic; font-size:1.5rem; color:var(--cream);
    max-width:38ch; line-height:1.5;
  }
  .craft-boast em{ color:var(--gold); font-style:italic; }

  /* ROOTS */
  .roots{ display:grid; grid-template-columns:0.9fr 1.1fr; gap:60px; align-items:center; }
  .pin-wrap{ position:relative; display:flex; align-items:center; justify-content:center; }
  .pin-wrap svg{ width:100%; max-width:280px; }
  .pin-ring{
    stroke:var(--gold); fill:none; stroke-width:1;
    animation:ripple 2.6s ease-out infinite;
    transform-origin:center;
  }
  .pin-ring.d2{ animation-delay:.9s; }
  .pin-ring.d3{ animation-delay:1.8s; }
  @keyframes ripple{
    0%{ transform:scale(0.4); opacity:0.9; }
    100%{ transform:scale(1.6); opacity:0; }
  }
  .roots p{ font-size:1.08rem; line-height:1.85; color:var(--cream); max-width:54ch; margin-bottom:18px; }
  .roots .muted{ color:var(--muted); }
  .roots-tags{ display:flex; gap:14px; flex-wrap:wrap; margin-top:26px; }
  .roots-tags span{
    font-family:'JetBrains Mono',monospace; font-size:0.72rem; letter-spacing:0.1em;
    color:var(--green); border:1px solid var(--line); padding:8px 14px; border-radius:2px;
    opacity:0; transform:translateY(14px) scale(.94);
    transition:opacity .5s var(--ease), transform .5s var(--ease);
  }
  .roots.in-view .roots-tags span:nth-child(1){ transition-delay:.1s; }
  .roots.in-view .roots-tags span:nth-child(2){ transition-delay:.28s; }
  .roots.in-view .roots-tags span:nth-child(3){ transition-delay:.46s; }
  .roots.in-view .roots-tags span{ opacity:1; transform:translateY(0) scale(1); }
  .roots-line{ height:1px; background:var(--gold); width:0%; margin-top:18px; transition:width 1s var(--ease) .7s; }
  .roots.in-view .roots-line{ width:100%; max-width:280px; }

  /* FOOTER */
  footer{
    text-align:center;
    padding:clamp(70px, 16vh, 160px) clamp(20px, 8vw, 100px) clamp(50px, 10vh, 100px);
    max-width:1440px;
    margin:0 auto;
    border-top:1px solid var(--line);
  }
  .signature{
    font-family:'Caveat',cursive; font-weight:600;
    font-size:clamp(3rem, 8vw, 5.5rem);
    color:var(--gold);
    margin-bottom:6px;
    opacity:0; transform:translateY(16px) scale(.94);
    transition:opacity .9s var(--ease), transform .9s var(--ease);
  }
  footer.in-view .signature{ opacity:1; transform:translateY(0) scale(1); }
  .swash{
    display:block; height:2px; background:var(--gold);
    width:0; margin:0 auto 26px;
    transition:width 1s var(--ease) .5s;
  }
  footer.in-view .swash{ width:170px; }
  footer p{ color:var(--muted); max-width:50ch; margin:0 auto 8px; line-height:1.7; }
  .footer-secret{
    margin-top:34px; font-family:'Fraunces',serif; font-style:italic; color:var(--green);
    font-size:0.95rem; opacity:0; transition:opacity 1s ease 1.4s;
  }
  footer.in-view .footer-secret{ opacity:1; }
  footer .fine{
    margin-top:40px;
    font-family:'JetBrains Mono',monospace; font-size:0.68rem; letter-spacing:0.16em; color:var(--muted); opacity:.7;
  }

  /* TABLET */
  @media (max-width: 1024px){
    .quiet-grid{ gap:44px; }
    .roots{ gap:44px; }
    .blob{ opacity:.35; }
  }

  /* SMALL TABLET / LARGE PHONE */
  @media (max-width: 860px){
    .quiet-grid, .roots{ grid-template-columns:1fr; gap:36px; }
    .roots{ text-align:left; }
    .pin-wrap{ order:-1; max-width:200px; margin:0 auto; }
    .cards{ grid-template-columns:1fr; }
    .card{ padding:36px 28px; }
  }

  /* MOBILE */
  @media (max-width: 600px){
    section, header.hero{ padding-left:22px; padding-right:22px; }
    nav{ padding-left:20px; padding-right:20px; }
    .navtag{ font-size:0.56rem; letter-spacing:0.1em; }
    .hero{ align-items:flex-start; text-align:left; }
    .display-name{ font-size:clamp(2.5rem, 13vw, 4.2rem); }
    .eyebrow{ font-size:0.62rem; letter-spacing:0.2em; margin-bottom:18px; }
    .akiiki-tag{ font-size:0.9rem; margin-top:16px; }
    .akiiki-tag span{ font-size:1.02rem; }
    .typed-wrap{ margin-top:40px; font-size:0.85rem; line-height:1.5; }
    .waveline{ margin-top:44px; width:100%; }
    .scroll-cue{ display:none; }

    h2.section-title{ font-size:clamp(1.7rem, 8vw, 2.2rem); max-width:100%; margin-bottom:26px; }
    .quiet p, .origin p, .roots p{ font-size:0.98rem; line-height:1.75; max-width:100%; }
    .boast-line{ font-size:1.15rem; padding-left:18px; max-width:100%; }
    .year-mark{ font-size:clamp(3.4rem, 26vw, 6rem); }
    .origin-title{ max-width:100%; margin-left:0; margin-right:0; }
    .craft-boast{ font-size:1.2rem; max-width:100%; }

    .roots-tags{ gap:10px; }
    .roots-tags span{ font-size:0.64rem; padding:7px 12px; }

    .signature{ font-size:clamp(2.4rem, 15vw, 3.4rem); }
    footer{ padding:70px 22px 50px; }
    footer p{ font-size:0.95rem; }
    .blob{ display:none; }
  }

  /* SMALL PHONE */
  @media (max-width: 380px){
    .display-name{ font-size:clamp(2.1rem, 13vw, 3.4rem); }
    .card{ padding:28px 20px; }
    .card h3{ font-size:1.3rem; }
  }

  /* ULTRA-WIDE DESKTOP */
  @media (min-width: 1800px){
    section, header.hero{ max-width:1560px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }

  a:focus-visible, button:focus-visible{ outline:2px solid var(--gold); outline-offset:3px; }
</style>
</head>
<body>

<div id="preloader">
  <div class="pre-word" id="preWord"></div>
  <div class="pre-line" id="preLine"></div>
  <div class="pre-tag" id="preTag">FRONT-END CRAFTSMAN · HOIMA, UGANDA</div>
</div>

<div class="blob blob-1"></div>
<div class="blob blob-2"></div>
<div class="progress" id="progress"></div>
<div class="glow" id="glow"></div>

<nav class="reveal" id="mainNav">
  <div class="brandmark">WILSAN</div>
  <div class="navtag">HOIMA CITY · UGANDA</div>
</nav>

<div class="chapter-nav" id="chapterNav">
  <button class="chapter-dot" data-target="quiet"><span class="chapter-label">I — Quiet</span></button>
  <button class="chapter-dot" data-target="origin"><span class="chapter-label">II — 2016</span></button>
  <button class="chapter-dot" data-target="craft"><span class="chapter-label">III — Craft</span></button>
  <button class="chapter-dot" data-target="roots"><span class="chapter-label">IV — Roots</span></button>
  <button class="chapter-dot" data-target="signed"><span class="chapter-label">V — Signed</span></button>
</div>

<header class="hero">
  <div class="eyebrow">FULL STACK DEVELOPER · FRONT-END AT HEART</div>
  <h1 class="display-name">BUSINGE<br><em>WILSON</em></h1>
  <div class="akiiki-tag">known, quietly, as <span>Akiiki</span> — "the friend"</div>
  <div class="typed-wrap"><span id="typed"></span><span class="cursor-blink"></span></div>
  <div class="waveline">
    <svg viewBox="0 0 600 60" preserveAspectRatio="none">
      <path d="M0,30 L600,30" />
      <path class="pulse" d="M0,30 L180,30 L200,8 L220,52 L240,30 L420,30 L440,14 L460,46 L480,30 L600,30" />
    </svg>
  </div>
  <div class="scroll-cue"><div class="bar"></div>SCROLL</div>
</header>

<section class="quiet reveal" id="quiet">
  <div class="quiet-grid">
    <div>
      <span class="mono-mark split" data-split>ON PERSONALITY</span>
      <h2 class="section-title split" data-split>A silence that is <em>chosen</em>, not shy.</h2>
    </div>
    <div data-stagger>
      <p class="stagger-child">Wilson does not fill a room with noise. He fills it with attention — watching longer than he speaks, and speaking only once he has something worth the interruption.</p>
      <p class="muted stagger-child">That is not a limitation. In his work, it is the whole method: study the problem quietly, let the idea take its full shape, then let the finished screen speak for him.</p>
      <p class="boast-line stagger-child">"I don't perform confidence. I build things confident enough to not need me to."</p>
      <div class="mini-wave stagger-child">
        <svg viewBox="0 0 300 40" preserveAspectRatio="none">
          <path class="mini-wave-path" d="M0,20 L60,20 L70,4 L80,36 L90,20 L120,20 L130,10 L140,30 L150,20 L300,20"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<section class="origin reveal" id="origin">
  <canvas id="embers-canvas" aria-hidden="true"></canvas>
  <div class="origin-content">
    <span class="mono-mark split" data-split>WHERE IT BEGAN</span>
    <div class="year-mark">2016</div>
    <h2 class="section-title origin-title split" data-split>The year a screen became a place he wanted to live in.</h2>
    <div data-stagger>
      <p class="stagger-child">Long before "developer" was a job title he could name, 2016 was the year Wilson first watched a blank page turn into something that moved, responded, and felt alive — and quietly decided this was going to be his life's work.</p>
      <p class="muted stagger-child">Everything since — every late night, every rebuilt layout, every small animation nobody else would have bothered to add — traces back to that first, private moment of falling in love with the craft.</p>
    </div>
  </div>
</section>

<section class="craft reveal" id="craft">
  <span class="mono-mark split" data-split>WHAT HE ACTUALLY DOES</span>
  <h2 class="section-title split" data-split>In plain words: <em>what you'd notice.</em></h2>
  <div class="cards" data-stagger>
    <div class="card card-pop">
      <span class="tag">FRONT-END</span>
      <h3>The part you touch</h3>
      <p>Every button, page, and screen you tap on a website — the layout, the colors, the way it feels under your thumb. This is where Wilson is sharpest: making a website feel effortless to use, even when it isn't simple to build.</p>
    </div>
    <div class="card card-pop">
      <span class="tag">FULL STACK</span>
      <h3>The part you never see</h3>
      <p>Behind every screen is a quiet engine handling logins, data, and requests. Wilson understands that engine too — so what he designs up front is never disconnected from what powers it underneath.</p>
    </div>
    <div class="card card-pop">
      <span class="tag">MOTION & DETAIL</span>
      <h3>The part you feel</h3>
      <p>The small pause before something appears. The gentle slide instead of a jarring jump. Wilson treats motion as a manner, not decoration — it's how a website earns your trust in the first second you meet it.</p>
    </div>
  </div>
  <p class="craft-boast reveal">He builds the kind of interfaces that make people forget <em>someone had to build them</em> — and that forgetting is the compliment he's after.</p>
</section>

<section class="roots reveal" id="roots">
  <div class="pin-wrap pin-reveal">
    <svg viewBox="0 0 200 200">
      <circle class="pin-ring" cx="100" cy="100" r="40"/>
      <circle class="pin-ring d2" cx="100" cy="100" r="40"/>
      <circle class="pin-ring d3" cx="100" cy="100" r="40"/>
      <circle cx="100" cy="100" r="6" fill="#c9a24b"/>
    </svg>
  </div>
  <div>
    <span class="mono-mark split" data-split>ROOTS</span>
    <h2 class="section-title split" data-split>Uganda raised him. <em>Kibingo</em> shaped him.</h2>
    <div data-stagger>
      <p class="stagger-child">Wilson's story starts far from any screen — in Hoima City, Uganda, in the quiet of Kibingo Cell, his home village. It's a place built on patience and community, and both followed him straight into his craft.</p>
      <p class="muted stagger-child">He carries that village into every product he ships: care taken slowly, work that respects the people who'll use it, and a quiet pride in where he's from that he never needs to announce loudly — because, true to form, he'd rather let the work say it.</p>
    </div>
    <div class="roots-tags">
      <span>UGANDA</span>
      <span>HOIMA CITY</span>
      <span>KIBINGO CELL</span>
    </div>
    <div class="roots-line"></div>
  </div>
</section>

<footer class="reveal" id="signed">
  <div class="signature">Akiiki</div>
  <span class="swash"></span>
  <div data-stagger>
    <p class="stagger-child">Busingye Wilson — a quiet front-end craftsman with full-stack range, building from Hoima City, Uganda for screens far beyond it.</p>
    <p class="stagger-child">Some people announce their skill. Wilson just ships it — and lets the silence after speak for itself.</p>
  </div>
  <p class="footer-secret">(you scrolled all the way here — thank you for that quiet patience.)</p>
  <div class="fine">EST. 2016 · HOIMA · UGANDA</div>
</footer>

<script>
(function(){
  "use strict";
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia('(pointer: fine)').matches;

  /* ---------- console easter egg ---------- */
  console.log(
    "%cYou found this.%c\nCurious minds do.\n\n— Akiiki, Busingye Wilson\nFront-end craftsman · Hoima City, Uganda\nBuilding quietly since 2016.",
    "color:#c9a24b; font-size:16px; font-weight:bold;",
    "color:#8c9089; font-size:12px;"
  );

  /* ---------- preloader ---------- */
  var preloader = document.getElementById('preloader');
  var preWord = document.getElementById('preWord');
  var preLine = document.getElementById('preLine');
  var preTag = document.getElementById('preTag');
  var word = "AKIIKI";

  function runPreloader(){
    document.body.classList.add('locked');
    word.split('').forEach(function(ch, i){
      var span = document.createElement('span');
      span.className = 'pre-letter';
      span.textContent = ch;
      preWord.appendChild(span);
      setTimeout(function(){ span.classList.add('show'); }, 200 + i * 90);
    });
    var afterLetters = 200 + word.length * 90 + 300;
    setTimeout(function(){ preLine.classList.add('grow'); }, afterLetters);
    setTimeout(function(){ preTag.classList.add('show'); }, afterLetters + 200);
    setTimeout(function(){
      preloader.classList.add('hide');
      document.body.classList.remove('locked');
      setTimeout(function(){ preloader.remove(); }, 950);
    }, afterLetters + 1000);
  }

  if(reducedMotion){
    preloader.remove();
  } else {
    runPreloader();
  }

  /* ---------- split text into words for stagger reveal ---------- */
  document.querySelectorAll('[data-split]').forEach(function(el){
    var text = el.textContent;
    el.innerHTML = '';
    text.split(/(\s+)/).forEach(function(chunk){
      if(chunk.trim() === ''){
        el.appendChild(document.createTextNode(chunk));
      } else {
        var wrap = document.createElement('span');
        wrap.className = 'word';
        var inner = document.createElement('span');
        inner.className = 'word-inner';
        inner.textContent = chunk;
        wrap.appendChild(inner);
        el.appendChild(wrap);
      }
    });
    var words = el.querySelectorAll('.word-inner');
    words.forEach(function(w, i){
      w.style.transitionDelay = (i * 45) + 'ms';
    });
  });

  /* ---------- typing effect ---------- */
  var line = "I build the front of the internet you fall in love with.";
  var typedEl = document.getElementById('typed');
  var i = 0;
  function typeChar(){
    if(i <= line.length){
      typedEl.textContent = line.slice(0, i);
      i++;
      setTimeout(typeChar, 38);
    }
  }
  setTimeout(typeChar, reducedMotion ? 200 : 2600);

  /* ---------- assign stagger delays to every group's children ---------- */
  document.querySelectorAll('[data-stagger]').forEach(function(group){
    var children = group.querySelectorAll(':scope > .stagger-child, :scope > .card-pop');
    children.forEach(function(child, idx){
      child.style.transitionDelay = (idx * 110) + 'ms';
    });
  });

  /* ---------- scroll reveal (IntersectionObserver) — replays every time a section re-enters view ---------- */
  var revealEls = document.querySelectorAll('.reveal, .split, [data-stagger]');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('in-view');
      } else {
        e.target.classList.remove('in-view');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
  revealEls.forEach(function(el){ io.observe(el); });

  /* ---------- progress bar + parallax blobs ---------- */
  var progress = document.getElementById('progress');
  var blobs = document.querySelectorAll('.blob');
  var ticking = false;
  function onScroll(){
    var h = document.documentElement;
    var scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
    progress.style.width = scrolled + '%';
    if(!reducedMotion){
      blobs.forEach(function(b, idx){
        var rate = idx === 0 ? 0.06 : -0.05;
        b.style.transform = 'translateY(' + (h.scrollTop * rate) + 'px)';
      });
    }
    ticking = false;
  }
  window.addEventListener('scroll', function(){
    if(!ticking){ window.requestAnimationFrame(onScroll); ticking = true; }
  });

  /* ---------- cursor glow ---------- */
  var glow = document.getElementById('glow');
  if(!reducedMotion && fine){
    window.addEventListener('mousemove', function(e){
      glow.style.left = e.clientX + 'px';
      glow.style.top = e.clientY + 'px';
    });
    document.querySelectorAll('.card, .chapter-dot, .roots-tags span').forEach(function(el){
      el.addEventListener('mouseenter', function(){ glow.classList.add('big'); });
      el.addEventListener('mouseleave', function(){ glow.classList.remove('big'); });
    });
  } else {
    glow.style.display = 'none';
  }

  /* ---------- card tilt ---------- */
  if(!reducedMotion && fine){
    document.querySelectorAll('.card').forEach(function(card){
      card.addEventListener('mousemove', function(e){
        var r = card.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width - 0.5;
        var y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = 'perspective(700px) rotateX(' + (y * -7) + 'deg) rotateY(' + (x * 7) + 'deg) translateY(-4px)';
      });
      card.addEventListener('mouseleave', function(){
        card.style.transform = 'perspective(700px) rotateX(0) rotateY(0) translateY(0)';
      });
    });
  }

  /* ---------- ember particles (2016 section) ---------- */
  var canvas = document.getElementById('embers-canvas');
  if(canvas && !reducedMotion){
    var ctx = canvas.getContext('2d');
    var particles = [];
    var emitting = false;
    var rafId = null;

    function resize(){
      var section = canvas.parentElement;
      canvas.width = section.clientWidth;
      canvas.height = section.clientHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    function spawn(){
      if(particles.length > 60) return;
      particles.push({
        x: Math.random() * canvas.width,
        y: canvas.height + 10,
        r: Math.random() * 2 + 1,
        speed: Math.random() * 0.6 + 0.3,
        drift: (Math.random() - 0.5) * 0.4,
        life: 1,
        flicker: Math.random() * 0.02
      });
    }

    function loop(){
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if(emitting && Math.random() < 0.35){ spawn(); }
      particles.forEach(function(p){
        p.y -= p.speed;
        p.x += p.drift;
        p.life -= 0.006;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(201,162,75,' + Math.max(p.life * 0.7, 0) + ')';
        ctx.fill();
      });
      particles = particles.filter(function(p){ return p.life > 0 && p.y > -20; });
      rafId = requestAnimationFrame(loop);
    }
    loop();

    var emberObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ emitting = e.isIntersecting; });
    }, { threshold: 0.2 });
    emberObserver.observe(document.getElementById('origin'));
  }

  /* ---------- chapter nav active state + scroll-to ---------- */
  var chapterIds = ['quiet', 'origin', 'craft', 'roots', 'signed'];
  var dots = document.querySelectorAll('.chapter-dot');
  dots.forEach(function(dot, idx){
    dot.addEventListener('click', function(){
      var target = document.getElementById(chapterIds[idx]);
      if(target){ target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
  var chapterObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      var idx = chapterIds.indexOf(e.target.id);
      if(idx === -1) return;
      if(e.isIntersecting){
        dots.forEach(function(d){ d.classList.remove('active'); });
        dots[idx].classList.add('active');
      }
    });
  }, { threshold: 0.4 });
  chapterIds.forEach(function(id){
    var el = document.getElementById(id);
    if(el) chapterObserver.observe(el);
  });
})();
</script>

</body>
</html>
